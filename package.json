{
  "name": "nazzel",
  "version": "0.1.0",
  "description": "Local-first terminal media downloader — beautiful TUI, powered by yt-dlp",
  "license": "MIT",
  "author": "Nazzel Contributors",
  "keywords": [
    "media",
    "downloader",
    "yt-dlp",
    "terminal",
    "tui",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "nazzel": "./dist/cli/index.js"
  },
  "main": "./dist/cli/index.js",
  "exports": {
    ".": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit --project tsconfig.test.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:tui": "vitest run tests/tui --passWithNoTests",
    "test:int": "vitest run tests/integration",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx src/cli/index.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "clipboardy": "^4.0.0",
    "commander": "^12.1.0",
    "env-paths": "^3.0.0",
    "execa": "^9.6.1",
    "extract-zip": "^2.0.1",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "ink-testing-library": "^3.0.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
